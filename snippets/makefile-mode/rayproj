# -*- mode: snippet -*-
# name: Raylib C project Makefile
# key: rayproj
# --
# Raylib C project — requires pkg-config and the Raylib development package.
CC       := cc
CFLAGS   := -std=c17 -Wall -Wextra -Wpedantic -g
CPPFLAGS := $(shell pkg-config --cflags raylib 2>/dev/null)
LDLIBS   := $(shell pkg-config --libs raylib 2>/dev/null)
TARGET   := ${1:game}
SRC_DIR  := ${2:src}
BUILD    := ${3:build}
SRCS     := $(wildcard $(SRC_DIR)/*.c)
OBJS     := $(patsubst $(SRC_DIR)/%.c,$(BUILD)/%.o,$(SRCS))
DEPS     := $(OBJS:.o=.d)

.PHONY: all run debug release check clean help assets

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) $^ $(LDLIBS) -o $@

$(BUILD)/%.o: $(SRC_DIR)/%.c
	mkdir -p $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

run: $(TARGET)
	./$(TARGET)

debug: CFLAGS += -O0 -DDEBUG -fsanitize=address,undefined
debug: LDFLAGS += -fsanitize=address,undefined
debug: clean all

release: CFLAGS := -std=c17 -Wall -Wextra -O2 -DNDEBUG
release: clean all

check:
	$(CC) $(CPPFLAGS) $(CFLAGS) -fsyntax-only $(SRCS)

clean:
	rm -rf $(BUILD) $(TARGET)

help:
	@printf "  make         Build $(TARGET)\n"
	@printf "  make run     Build and run $(TARGET)\n"
	@printf "  make debug   Sanitized debug build\n"
	@printf "  make release Optimized build\n"
	@printf "  make check   Syntax-only check\n"
	@printf "  make clean   Remove build artifacts\n"

-include $(DEPS)
$0